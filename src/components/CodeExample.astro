---
import { Code } from 'astro:components';
interface Props { code: string; title?: string; output?: string; }
const { code, title = 'PyTorch', output } = Astro.props;
---
<div class="code-example">
  <div class="code-example-heading"><span>代码</span><span>{title}</span></div>
  <Code code={code} lang="python" themes={{ light: 'github-light', dark: 'github-dark' }} />
  {output && <div class="code-output"><span>运行结果</span><samp>{output}</samp></div>}
</div>
<style>
  .code-example{margin:24px 0;min-width:0}
  .code-example-heading{display:flex;justify-content:space-between;font-size:10px;color:var(--muted);border-bottom:1px solid var(--line);padding-bottom:8px}
  .code-example :global(pre){margin-top:0;border-radius:0;padding-top:38px}
  .code-output{background:var(--accent-soft);border-left:2px solid var(--accent);padding:12px 16px;font-size:10px}
  .code-output>span{display:block;color:var(--muted);margin-bottom:5px}
  samp{display:block;font:11px/1.8 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere;color:var(--accent)}
</style>

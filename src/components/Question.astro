---
interface Props { id: string; number: number; question: string; }
const { id, number, question } = Astro.props;
---
<details class="qa-item" id={id}>
  <summary><span class="qa-number">Q{String(number).padStart(2, '0')}</span><span>{question}</span><span class="qa-expand" aria-hidden="true">+</span></summary>
  <div class="qa-answer"><span class="qa-answer-mark" aria-label="回答">A</span><div class="qa-answer-body"><slot /></div></div>
</details>

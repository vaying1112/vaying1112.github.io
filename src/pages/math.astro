---
import { getEntry, render } from 'astro:content';
import Reading from '../layouts/Reading.astro';
const entry = await getEntry('foundations', 'math-basics');
if (!entry) throw new Error('数学基础内容缺失');
const { Content, headings } = await render(entry);
---
<Reading title={entry.data.title} description={entry.data.description} headings={headings} backText="返回首页"><Content /></Reading>

---
import { href } from '../../site';
import { legacyVisualizationLinks } from '../../visualizations/legacy-links';
export function getStaticPaths() {
  return Object.entries(legacyVisualizationLinks).map(([id, target]) => ({ params: { id }, props: { target } }));
}
interface Props { target: string; }
return Astro.redirect(href(Astro.props.target), 301);
---

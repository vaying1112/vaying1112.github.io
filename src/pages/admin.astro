---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { href } from '../site';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).map(post => ({ id: post.id, title: post.data.title, url: href(`posts/${post.id}/`) }));
---
<Base title="评论管理" description="一帆书签评论管理后台。" noindex>
  <div class="admin-page shell" data-admin data-posts={JSON.stringify(posts)} data-account-url={href('account/')}>
    <header class="admin-heading"><p class="eyebrow">一帆书签 / 管理员</p><h1>评论管理</h1><p>查看讨论、删除评论，或从回收站恢复。</p></header>
    <p class="admin-message" data-message role="status" aria-live="polite">正在核对登录状态…</p>
    <section class="admin-card" data-access hidden><h2>请使用管理员账号登录</h2><p>读者账号不能管理评论。</p><a class="admin-primary" data-login-link>前往登录 ↗</a></section>
    <section class="admin-card setup-card" data-setup hidden>
      <h2>设置管理员密码</h2><form data-setup-form method="post">
        <label>管理员用户名<input name="username" readonly autocomplete="username" /></label>
        <label>密码<input name="password" type="password" required minlength="12" maxlength="128" autocomplete="new-password" /></label>
        <label>确认密码<input name="confirmPassword" type="password" required maxlength="128" autocomplete="new-password" /></label>
        <p>密码至少 12 位。激活后请保存找回码。</p><button class="admin-primary" type="submit" disabled>激活管理员账号</button>
      </form>
    </section>
    <section class="admin-card" data-recovery hidden><h2>保存管理员找回码</h2><p>忘记密码时可用它重设。找回码只显示这一次，请保存在密码管理器中。</p><code data-recovery-code></code><button type="button" class="admin-text" data-copy-recovery>复制找回码</button><button type="button" class="admin-primary" data-recovery-done>已保存，进入后台</button></section>
    <section data-dashboard hidden>
      <div class="admin-identity"><span><strong data-username></strong> · 管理员</span><div><a href={href('account/')}>账号设置</a><button class="admin-text" type="button" data-logout>退出登录</button></div></div>
      <div class="admin-filters"><label>文章<select data-post-filter><option value="">全部文章</option>{posts.map(post => <option value={post.id}>{post.title}</option>)}</select></label><div class="admin-tabs" role="group" aria-label="评论状态"><button type="button" data-view="active" aria-pressed="true">公开评论 <span data-active-count>0</span></button><button type="button" data-view="trash" aria-pressed="false">回收站 <span data-trash-count>0</span></button></div><button type="button" class="admin-text" data-refresh>刷新</button></div>
      <div class="admin-bulk"><p>删除会移入回收站，并取消相关待答任务。</p><button type="button" class="admin-danger" data-clear-post hidden>清空本篇评论</button></div>
      <div class="admin-comments" data-comments-list></div><button type="button" class="admin-more" data-more hidden>加载更多</button>
    </section>
    <dialog class="admin-confirm" data-confirm aria-labelledby="admin-confirm-title"><h2 id="admin-confirm-title">确认删除</h2><p data-confirm-text></p><form method="dialog"><button value="cancel" class="admin-text">取消</button><button value="confirm" class="admin-primary">确认删除</button></form></dialog>
    <noscript>请启用 JavaScript 以管理评论。</noscript>
  </div>
  <script>import '../scripts/admin-page';</script>
</Base>
<style>
.admin-page{max-width:960px;min-height:65vh;padding-block:40px 65px}.admin-heading h1{font:500 32px/1.5 var(--serif);margin:10px 0}.admin-heading>p:last-child{font-size:13px;color:var(--muted)}.admin-message{font-size:12px;color:var(--muted);min-height:22px;margin-block:20px}.admin-message[data-error]{color:var(--warm)}.admin-card{max-width:460px;border:1px solid var(--line);background:var(--surface);padding:25px;border-radius:7px}.admin-card h2,.admin-confirm h2{font:500 21px/1.5 var(--serif);margin-bottom:18px}.admin-card p{font-size:12px;color:var(--muted);line-height:1.9}.admin-card label{display:grid;gap:7px;margin-bottom:18px;font-size:12px}.admin-card input{width:100%;border:1px solid var(--line);background:var(--paper);color:var(--ink);padding:10px 11px;border-radius:4px;font-size:14px}.admin-card input[readonly]{color:var(--muted)}.admin-primary{display:inline-block;border:0;background:var(--accent);color:var(--paper);border-radius:4px;padding:10px 16px;font-size:12px}.admin-text{border:0;background:transparent;color:var(--accent);padding:8px 10px;font-size:12px}.admin-danger{border:1px solid var(--line);background:transparent;color:var(--warm);border-radius:4px;padding:7px 12px;font-size:11px}.admin-identity{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:15px;font-size:12px;color:var(--muted)}.admin-identity strong{color:var(--ink)}.admin-identity a{color:var(--accent);margin-right:12px}.admin-filters{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:24px}.admin-filters label{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--muted)}select{max-width:280px;padding:8px 25px 8px 10px;color:var(--ink);border:1px solid var(--line);background:var(--surface);border-radius:4px;font-size:12px}.admin-tabs{display:flex;gap:18px;margin-left:auto}.admin-tabs button{border:0;border-bottom:2px solid transparent;background:none;color:var(--muted);padding:8px 0;font-size:12px}.admin-tabs button[aria-pressed=true]{border-color:var(--accent);color:var(--accent)}.admin-tabs span{font:10px var(--mono);margin-left:5px}.admin-bulk{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:20px 0}.admin-bulk p{font-size:11px;color:var(--muted);margin:0}.admin-more{display:block;margin:25px auto 0;border:1px solid var(--line);background:transparent;color:var(--accent);padding:9px 18px;border-radius:4px;font-size:12px}.admin-confirm{max-width:420px;width:calc(100% - 40px);padding:26px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink)}.admin-confirm::backdrop{background:#18261e66}.admin-confirm p{font-size:13px;line-height:1.9}.admin-confirm form{display:flex;justify-content:flex-end;gap:14px;margin-top:25px}.admin-card code{display:block;overflow-wrap:anywhere;padding:12px;background:var(--code);font:13px/1.8 var(--mono);margin:15px 0}.admin-card [data-recovery-done]{display:block;margin-top:15px}
.admin-comments :global(.admin-comment){border:1px solid var(--line);border-radius:6px;background:var(--surface);padding:21px;margin-bottom:15px;font-size:13px;overflow-wrap:anywhere}.admin-comments :global(.admin-comment.is-ai){border-left:3px solid var(--qa-answer)}.admin-comments :global(.admin-meta){display:flex;gap:10px;flex-wrap:wrap;align-items:center;font-size:11px;color:var(--muted);margin-bottom:12px}.admin-comments :global(.admin-meta strong){color:var(--ink)}.admin-comments :global(.admin-meta a){color:var(--accent)}.admin-comments :global(blockquote){margin:12px 0;padding-left:12px;border-left:2px solid var(--line);color:var(--muted);font-size:12px}.admin-comments :global(.comment-body){line-height:1.9;max-height:280px;overflow:auto}.admin-comments :global(.comment-body p){margin:0 0 .7em}.admin-comments :global(.comment-body pre){overflow:auto;background:var(--code);padding:12px;font:11px/1.8 var(--mono)}.admin-comments :global(.katex-display){overflow:auto}.admin-comments :global(.admin-comment-actions){display:flex;justify-content:space-between;align-items:center;gap:12px;border-top:1px solid var(--line);margin-top:16px;padding-top:12px;font-size:10px;color:var(--muted)}.admin-comments :global(.admin-comment-actions button){border:0;background:none;color:var(--warm);font-size:11px;padding:5px 0}.admin-comments :global(.admin-comment-actions a){color:var(--accent)}.admin-comments :global(.admin-empty){color:var(--muted);font-size:13px;padding:28px 0}
@media(max-width:640px){.admin-page{padding-top:25px}.admin-heading h1{font-size:27px}.admin-filters{gap:12px}.admin-tabs{margin-left:0}.admin-filters>[data-refresh]{margin-left:auto}.admin-bulk{align-items:start}.admin-comments :global(.admin-comment){padding:16px}.admin-bulk p{max-width:190px}.admin-identity{gap:12px}}
</style>

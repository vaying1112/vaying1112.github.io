---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { visualizations, visualizationIds } from '../visualizations/registry';
import { href, showDrafts } from '../site';
const posts = await getCollection('posts', ({ data }) => showDrafts || !data.draft);
---
<Base title="实验室">
  <div id="top"></div>
  <section class="compact-heading shell"><h1>实验室</h1></section>
  <div class="lab-catalog shell">
    {visualizationIds.map((id, i) => {
      const experiment = visualizations[id];
      const related = posts.filter(post => post.data.visualizations.includes(id));
      return <article class="experiment-card">
        <div class="experiment-meta"><span>{experiment.topic}</span><span>{String(i + 1).padStart(2, '0')}</span></div>
        <h2><a href={href(`lab/${id}/`)}>{experiment.title}</a></h2>
        <p>{experiment.description}</p>
        <a class="text-link" href={href(`lab/${id}/`)}>打开实验 →</a>
        {related.length > 0 && <div class="experiment-related"><span>引用文章</span>{related.map(post => <a href={href(`posts/${post.id}/`)}>{post.data.title}{post.data.draft && <small>草稿</small>}</a>)}</div>}
      </article>;
    })}
  </div>
</Base>
<style>
  .lab-catalog{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-block:8px 60px}
  .experiment-card{padding:28px;border:1px solid var(--line);background:var(--surface)}
  .experiment-meta{display:flex;justify-content:space-between;font:10px var(--mono);color:var(--muted)}
  .experiment-card h2{font:500 23px/1.6 var(--serif);margin:24px 0 10px}
  .experiment-card h2 a:hover{color:var(--accent)}
  .experiment-card>p{font-size:12px;line-height:1.9;color:var(--muted);margin-bottom:22px}
  .experiment-related{display:flex;flex-direction:column;gap:9px;font-size:11px;border-top:1px solid var(--line);padding-top:20px;margin-top:24px}
  .experiment-related>span{font-size:10px;color:var(--muted)}
  .experiment-related a{color:var(--accent)}
  .experiment-related small{margin-left:9px;color:var(--muted);font-size:9px}
  @media(max-width:640px){.lab-catalog{grid-template-columns:1fr;gap:18px}.experiment-card{padding:24px}}
</style>

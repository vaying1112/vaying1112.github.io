{
  "name": "learning-notes-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test:comments": "node --test tests/comments.test.mjs",
    "comments:setup": "node scripts/setup-comments-local.mjs",
    "comments:dev": "wrangler dev --local --ip 127.0.0.1 --config services/comments/wrangler.local.jsonc --port 8787",
    "comments:migrate:local": "wrangler d1 migrations apply yifan-comments --local --config services/comments/wrangler.local.jsonc",
    "comments:deploy": "wrangler deploy --config services/comments/wrangler.jsonc",
    "comments:respond": "node --env-file=.comments-local/responder.env scripts/comment-responder.mjs",
    "comments:respond:local": "node --env-file=.comments-local/responder.local.env scripts/comment-responder.mjs",
    "comments:service:install": "node scripts/comment-service.mjs",
    "comments:service:remove": "node scripts/comment-service.mjs --remove"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "latest",
    "@astrojs/mdx": "latest",
    "@astrojs/rss": "latest",
    "astro": "7.4.0",
    "katex": "^0.16.22",
    "marked": "^18.1.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@openai/codex": "0.163.0",
    "typescript": "latest",
    "wrangler": "^4.151.1"
  }
}
